MeuGerenciador:
    LoginScreen:
    SupervisorScreen:
    VigilanteScreen:
    CadastroVigilanteScreen:
    RemoverVigilanteScreen:
    OcorrenciaScreen:

<LoginScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'login_screen'
    FloatLayout:
        Image:
            source: 'grupoft.png'
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "y": 0.30}
        TextInput:
            id: nome_usuario
            hint_text: 'USUÁRIO'
            multiline: False
            size_hint: 0.5, 0.06
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.55}
        TextInput:
            id: senha_usuario
            hint_text: 'SENHA'
            password: True
            multiline: False
            size_hint: 0.5, 0.06
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.45}
        Button:
            text: 'ENTRAR'
            size_hint: 0.3, None
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.35}
            on_release: root.verificar_login()
        Button:
            text: 'FECHAR'
            size_hint: 0.15, None
            height: '50dp'
            font_size: '18sp'
            background_color: 1, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.25}
            on_release: app.fechar_aplicativo()

<SupervisorScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: "supervisor_screen"
    FloatLayout:
        Label:
            id: letreiro
            text: ''
            size_hint: None, None
            color: 0, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.55}
        Button:
            text: 'CADASTRAR VIGILANTE'
            size_hint: 0.3, None
            font_size: '18sp'
            height: '50dp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
            on_release: root.manager.current = 'cadastro_vigilante'
        Button:
            text: 'REMOVER VIGILANTE'
            size_hint: 0.3, None
            font_size: '18sp'
            height: '50dp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
            on_release: root.manager.current = 'remover_vigilante'
        Button:
            text: 'SAIR'
            size_hint: 0.15, None
            font_size: '18sp'
            height: '50dp'
            background_color: 1, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.3}
            on_release: root.desconectar()

<CadastroVigilanteScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'cadastro_vigilante'
    FloatLayout:
        Label:
            id: letreiro_cadastro_vigilante
            text: 'CADASTRO DE VIGILANTE'
            size_hint: None, None
            color: 0, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.75}
        TextInput:
            id: nome_completo
            hint_text: 'NOME COMPLETO'
            multiline: False
            size_hint: 0.5, 0.06
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.7}
        TextInput:
            id: matricula
            hint_text: 'MATRÍCULA'
            multiline: False
            size_hint: 0.5, 0.06
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.6}
        TextInput:
            id: login_vigilante
            hint_text: 'USUÁRIO'
            multiline: False
            size_hint: 0.5, 0.06
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
        TextInput:
            id: senha1_vigilante
            hint_text: 'DIGITE UMA SENHA'
            password: True
            multiline: False
            size_hint: 0.5, 0.06
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
        TextInput:
            id: senha2_vigilante
            hint_text: 'REPITA A SENHA'
            password: True
            multiline: False
            size_hint: 0.5, 0.06
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.3}
        Button:
            text: 'CADASTRAR VIGILANTE'
            size_hint: 0.3, None
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.2}
            on_release: root.cadastrar_vigilante()
        Button:
            text: 'VOLTAR'
            background_color: 1, 0, 0, 1
            size_hint: 0.15, None
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.1}
            on_release: root.manager.current = 'supervisor_screen'
        Label:
            id: letreiro_feed_back
            text: ''
            size_hint: None, None
            color: 0, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.04}

<RemoverVigilanteScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'remover_vigilante'
    FloatLayout:
        Label:
            text: 'REMOVER CADASTRO'
            color: 0, 0, 0, 1
            size_hint: None, None
            pos_hint: {'center_x': 0.5, 'y': 0.6}
        TextInput:
            id: nome_vigilante_remover
            hint_text: 'NOME COMPLETO'
            multiline: False
            size_hint: 0.5, 0.06
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
        Button:
            text: 'REMOVER CADASTRO'
            size_hint: 0.3, None
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
            on_release: root.remover_vigilante()
        Button:
            text: 'VOLTAR'
            background_color: 1, 0, 0, 1
            size_hint: 0.15, None
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.3}
            on_release: root.manager.current = 'supervisor_screen'

<VigilanteScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: "vigilante_screen"
    FloatLayout:
        Label:
            id: letreiro_vigilante
            text: ''
            size_hint: None, None
            color: 0, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.56}
        Button:
            text: "REGISTRAR OCORRÊNCIA"
            size_hint: 0.3, None
            font_size: '18sp'
            height: '50dp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
            on_release: root.manager.current = 'ocorrencia_screen'
        Button:
            text: "Sair"
            size_hint: 0.15, None
            font_size: '18sp'
            height: '50dp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
            background_color: 1, 0, 0, 1
            on_release: root.desconectar()

<OcorrenciaScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: "ocorrencia_screen"
    FloatLayout:
        Label:
            text: 'REGISTRAR OCORRÊNCIA'
            color: 0, 0, 0, 1
            size_hint: None, None
            pos_hint: {'center_x': 0.5, 'y': 0.6}
        TextInput:
            id: nome_posto
            hint_text: 'NOME DO POSTO'
            multiline: False
            size_hint: 0.5, 0.06
            height: '50dp'
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
        Button:
            text: "VOLTAR"
            size_hint: 0.15, None
            font_size: '18sp'
            height: '50dp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
            background_color: 1, 0, 0, 1
            on_release: root.manager.current = "vigilante_screen"