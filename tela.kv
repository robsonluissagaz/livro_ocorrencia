MeuGerenciador:
    LoginScreen:
    SupervisorScreen:
    VigilanteScreen:
    ErroSenhaUsuarioScreen:
    CadastroVigilanteScreen:
    RemoverVigilanteScreen:

<LoginScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'login_screen'
    Image:
        source: 'grupoft.png'
        size_hint: 0.80, 0.80
        pos_hint: {'x': 0.1, 'y': 0.4}
    TextInput:
        id: nome_usuario
        hint_text: 'NOME DO USUÁRIO'
        multiline: False
        size_hint_x: None
        size_hint_y: None
        width: 300
        height: '30dp'
        pos_hint: {'x': 0.3, 'y': 0.6}
    TextInput:
        id: senha_usuario
        hint_text: 'SENHA'
        password: True
        multiline: False
        size_hint_x: None
        size_hint_y: None
        width: 300
        height: '30dp'
        pos_hint: {'x': 0.3, 'y': 0.5}
    Label:
        id: mensagem
        text: ''
        color: 1, 0, 0, 1
    Button:
        text: 'ENTRAR'
        size_hint_x: None
        size_hint_y: None
        width: 150
        height: '40dp'
        pos_hint: {'x':0.4,'y':0.4}
        on_release: root.verificar_login()
    Button:
        text: 'FECHAR PROGRAMA'
        size_hint_x: None
        size_hint_y: None
        width: 150
        height: '40dp'
        pos_hint: {'x':0.4,'y':0.3}
        background_color: 1, 0, 0, 1
        on_release: app.fechar_aplicativo()

<SupervisorScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: "supervisor_screen"
    Label:
        id: letreiro
        text: ''
        size_hint_x: None
        size_hint_y: None
        color: 0, 0, 0, 1
        pos_hint: {'x':0.45,'y':0.75}
    Button:
        text: 'CADASTRAR VIGILANTE'
        size_hint_x: None
        size_hint_y: None
        width: self.texture_size[0] + 20
        height: '40dp'
        pos_hint: {'x':0.4,'y':0.7}
        on_release: root.manager.current = 'cadastro_vigilante'
    Button:
        text: 'REMOVER VIGILANTE'
        size_hint_x: None
        size_hint_y: None
        width: self.texture_size[0] + 20
        height: '40dp'
        pos_hint: {'x':0.41,'y':0.6}
        on_release: root.manager.current = 'remover_vigilante'
    Button:
        text: 'SAIR'
        size_hint: None, None
        height: '40dp'
        width: self.texture_size[0] + 20
        pos_hint: {'x':0.47,'y':0.5}
        background_color: 1, 0, 0, 1
        on_release: root.manager.current = 'login_screen'

<CadastroVigilanteScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'cadastro_vigilante'
    Label:
        id: letreiro_cadastro_vigilante
        text: 'CADASTRO DE VIGILANTE'
        color: 0, 0, 0, 1
        size_hint_x: None
        size_hint_y: None
        pos_hint: {'x': 0.4, 'y': 0.84}
    TextInput:
        id: nome_completo
        hint_text: 'NOME COMPLETO'
        multiline: False
        size_hint_x: None
        size_hint_y: None
        width: 300
        height: '30dp'
        pos_hint: {'x': 0.3, 'y': 0.8}
    TextInput:
        id: login_vigilante
        hint_text: 'USUÁRIO'
        multiline: False
        size_hint_x: None
        size_hint_y: None
        width: 300
        height: '30dp'
        pos_hint: {'x': 0.3, 'y': 0.7}
    TextInput:
        id: senha1_vigilante
        hint_text: 'DIGITE UMA SENHA'
        password: True
        multiline: False
        size_hint_x: None
        size_hint_y: None
        width: 300
        height: '30dp'
        pos_hint: {'x': 0.3, 'y': 0.6}
    TextInput:
        id: senha2_vigilante
        hint_text: 'REPITA A SENHA'
        password: True
        multiline: False
        size_hint_x: None
        size_hint_y: None
        width: 300
        height: '30dp'
        pos_hint: {'x': 0.3, 'y': 0.5}
    Button:
        text: 'CADASTRAR VIGILANTE'
        width: self.texture_size[0] + 20
        height: '40dp'
        size_hint_x: None
        size_hint_y: None
        pos_hint: {'x': 0.36, 'y': 0.4}
        on_release: root.cadastrar_vigilante()
    Button:
        text: 'VOLTAR'
        background_color: 1, 0, 0, 1
        height: '40dp'
        size_hint_x: None
        size_hint_y: None
        pos_hint: {'x': 0.41, 'y': 0.3}
        on_release: root.manager.current = 'supervisor_screen'
    Label:
        id: letreiro_feed_back
        text: ''
        color: 1, 1, 1, 1
        size_hint_x: None
        size_hint_y: None
        pos_hint: {'x': 0.4, 'y': 0.2}


<RemoverVigilanteScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'remover_vigilante'
    Label:
        text: 'REMOVER CADASTRO'
        color: 0, 0, 0, 1
        size_hint_x: None
        size_hint_y: None
        pos_hint: {'x': 0.4, 'y': 0.65}
    TextInput:
        id: nome_vigilante_remover
        hint_text: 'NOME COMPLETO'
        multiline: False
        size_hint_x: None
        size_hint_y: None
        width: 300
        height: '30dp'
        pos_hint: {'x': 0.3, 'y': 0.6}
    Button:
        text: 'REMOVER CADASTRO'
        width: self.texture_size[0] + 20
        height: '40dp'
        size_hint_x: None
        size_hint_y: None
        pos_hint: {'x': 0.36, 'y': 0.5}
    Button:
        text: 'VOLTAR'
        background_color: 1, 0, 0, 1
        height: '40dp'
        size_hint_x: None
        size_hint_y: None
        pos_hint: {'x': 0.41, 'y': 0.4}
        on_release: root.manager.current = 'supervisor_screen'


<VigilanteScreen>:
    name: "vigilante_screen"
    BoxLayout:
        orientation: "vertical"
        Label:
            id: letreiro_vigilante
            text: ''
        Button:
            text: "Sair"
            background_color: 1, 0, 0, 1
            height: '40dp'
            size_hint_x: None
            size_hint_y: None
            pos_hint: {'x': 0.42, 'y': 0.3}
            on_release: app.root.current = "login_screen"

<ErroSenhaUsuarioScreen>:
    name: 'erro_senha_usuario'
    Label:
        text: 'USUÁRIO OU SENHA INCORRETO'
        color: 1, 0, 0, 1
        size_hint_x: None
        size_hint_y: None
        pos_hint: {'center_x':0.5,'center_y':0.6}
    Button:
        text: "VOLTAR"
        size_hint_x: None
        size_hint_y: None
        width: 150
        height: '40dp'
        pos_hint: {'x':0.4,'y':0.4}
        on_release: app.root.current = "login_screen"
