MeuGerenciador:
    LoginScreen:
    SupervisorScreen:
    VigilanteScreen:
    CadastroVigilanteScreen:
    RemoverVigilanteScreen:
    OcorrenciaScreen:
    RelatorioOcorrenciaScreen:
    RelatorioOcorrenciaScreen2:
    RelatorioOcorrenciaScreen3:

<LoginScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'login_screen'
    FloatLayout:
        Image:
            source: 'grupoft.png'
            size_hint: 1.5, 0.8
            pos_hint: {'center_x': 0.5, 'y': 0.40}
            fit_mode: "fill"
        TextInput:
            id: nome_usuario
            hint_text: 'USUÁRIO'
            multiline: False
            size_hint: 0.6, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.55}
        TextInput:
            id: senha_usuario
            hint_text: 'SENHA'
            password: True
            multiline: False
            size_hint: 0.6, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.45}
        Button:
            text: 'ENTRAR'
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.35}
            on_release: root.verificar_login()
        Button:
            text: 'FECHAR'
            size_hint: 0.3, 0.08
            font_size: '18sp'
            background_color: 1, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.15}
            on_release: app.fechar_aplicativo()

<SupervisorScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: "supervisor_screen"
    FloatLayout:
        Label:
            id: letreiro
            text: ''
            size_hint: None, None
            color: 0, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.6}
        Button:
            text: 'CADASTRAR VIGILANTE'
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
            on_release: root.manager.current = 'cadastro_vigilante'
        Button:
            text: 'REMOVER VIGILANTE'
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
            on_release: root.manager.current = 'remover_vigilante'
        Button:
            text: 'RELATÓRIO DE OCORRÊNCIAS'
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.3}
            on_release: root.manager.current = 'relatorio_ocorrencia'
        Button:
            text: 'SAIR'
            size_hint: 0.3, 0.08
            font_size: '18sp'
            background_color: 1, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.2}
            on_release: root.desconectar()

<CadastroVigilanteScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'cadastro_vigilante'
    FloatLayout:
        Label:
            id: letreiro_cadastro_vigilante
            text: 'CADASTRO DE VIGILANTE'
            size_hint: None, None
            color: 0, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.80}
        TextInput:
            id: nome_completo
            hint_text: 'NOME COMPLETO'
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.7}
        TextInput:
            id: matricula
            hint_text: 'MATRÍCULA'
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.6}
            input_filter: 'int'
            input_type: 'number'
            on_text: if not self.text.isdigit(): self.text = ''.join(filter(str.isdigit, self.text))
        TextInput:
            id: login_vigilante
            hint_text: 'USUÁRIO'
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
        TextInput:
            id: senha1_vigilante
            hint_text: 'DIGITE UMA SENHA'
            password: True
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
        TextInput:
            id: senha2_vigilante
            hint_text: 'REPITA A SENHA'
            password: True
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.3}
        Button:
            text: 'CADASTRAR VIGILANTE'
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.2}
            on_release: root.cadastrar_vigilante()
        Button:
            text: 'VOLTAR'
            background_color: 1, 0, 0, 1
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.1}
            on_release: root.manager.current = 'supervisor_screen'

<RelatorioOcorrenciaScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'relatorio_ocorrencia'
    FloatLayout:
        TextInput:
            id: pesquisa_matricula
            hint_text: 'INSIRA A MATRÍCULA'
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.6}
            input_filter: 'int'
            input_type: 'number'
            on_text: if not self.text.isdigit(): self.text = ''.join(filter(str.isdigit, self.text))
        Button:
            text: 'PESQUISAR'
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
            on_release: root.carregar_ocorrencias()
        Button:
            text: 'VOLTAR'
            background_color: 1, 0, 0, 1
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.3}
            on_release: root.voltar()

<RelatorioOcorrenciaScreen2>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'relatorio_ocorrencia2'
    FloatLayout:
        Label:
            id: label_letreiro
            text: 'Lista de Ocorrências'
            size_hint: None, None
            font_size: '20sp'
            color: 0, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.9}
        RecycleView:
            id: rv_ocorrencias
            size_hint: 0.9, 0.7
            pos_hint: {'center_x': 0.5, 'y': 0.2}
            viewclass: 'SelectableLabel'
            RecycleBoxLayout:
                default_size: None, dp(48)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'
        Button:
            text: 'VOLTAR'
            background_color: 1, 0, 0, 1
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.1}
            on_release: root.manager.current = 'relatorio_ocorrencia'

<SelectableLabel@Button>:
    size_hint_y: None
    height: dp(48)
    background_normal: ''
    background_color: (0.6, 0, 0, 1) if self.state == 'normal' else (1, 1, 1, 1)
    on_release: app.root.get_screen('relatorio_ocorrencia2').buscar_ocorrido(self.text)
    pos_hint: {'center_x': 0.5, 'center_y': 0.5}

<RelatorioOcorrenciaScreen3>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'relatorio_ocorrencia3'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(10)
        ScrollView:
            size_hint: 1, 1
            do_scroll_x: False
            do_scroll_y: True
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                padding: dp(10)
                width: self.minimum_width
                height: self.minimum_height
                Label:
                    id: conteudo_ocorrido
                    color: 0, 0, 0, 1
                    text: ""
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width - dp(20), None
                    halign: 'left'
                    valign: 'top'
                    padding: dp(10), dp(10)
        Button:
            text: 'VOLTAR'
            background_color: 1, 0, 0, 1
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.1}
            on_release: root.manager.current = 'relatorio_ocorrencia2'

<RemoverVigilanteScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'remover_vigilante'
    FloatLayout:
        Label:
            text: 'REMOVER CADASTRO'
            color: 0, 0, 0, 1
            size_hint: None, None
            pos_hint: {'center_x': 0.5, 'y': 0.6}
        TextInput:
            id: matricula_vigilante_remover
            hint_text: 'MATRÍCULA'
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
            input_filter: 'int'
            input_type: 'number'
            on_text: if not self.text.isdigit(): self.text = ''.join(filter(str.isdigit, self.text))
        Button:
            text: 'REMOVER CADASTRO'
            size_hint: (0.7, 0.08)
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
            on_release: root.remover_vigilante()
        Button:
            text: 'VOLTAR'
            background_color: 1, 0, 0, 1
            size_hint: (0.3, 0.08)
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.2}
            on_release: root.manager.current = 'supervisor_screen'

<VigilanteScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: "vigilante_screen"
    FloatLayout:
        Label:
            id: letreiro_vigilante
            text: ''
            size_hint: None, None
            color: 0, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.6}
        Button:
            text: "REGISTRAR OCORRÊNCIA"
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
            on_release: root.manager.current = 'ocorrencia_screen'
        Button:
            text: "Sair"
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.3}
            background_color: 1, 0, 0, 1
            on_release: root.desconectar()

<OcorrenciaScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: "ocorrencia_screen"
    FloatLayout:
        Label:
            text: 'REGISTRAR OCORRÊNCIA'
            color: 0, 0, 0, 1
            size_hint: None, None
            pos_hint: {'center_x': 0.5, 'y': 0.85}
        TextInput:
            id: posto
            hint_text: 'NOME DO POSTO'
            multiline: False
            size_hint: 0.5, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.8}
        TextInput:
            id: ocorrido
            hint_text: 'DIGITE A OCORRÊNCIA'
            multiline: True
            size_hint: 0.9, 0.3
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.45}
        Button:
            text: "REGISTRAR OCORRÊNCIA"
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.35}
            on_release: root.confirmar_registro_ocorrencia()
        Button:
            text: "VOLTAR"
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.05}
            background_color: 1, 0, 0, 1
            on_release: root.manager.current = "vigilante_screen"
