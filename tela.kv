MeuGerenciador:
    LoginScreen:
    SupervisorScreen:
    VigilanteScreen:
    CadastroVigilanteScreen:
    RemoverVigilanteScreen:
    OcorrenciaScreen:
    RelatorioOcorrenciaScreen:

<LoginScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'login_screen'
    FloatLayout:
        Image:
            source: 'grupoft.png'
            size_hint: 1, 1
            pos_hint: {'center_x': 0.5, 'y': 0.25}
            allow_stretch: True
        TextInput:
            id: nome_usuario
            hint_text: 'USUÁRIO'
            multiline: False
            size_hint: 0.6, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.55}
        TextInput:
            id: senha_usuario
            hint_text: 'SENHA'
            password: True
            multiline: False
            size_hint: 0.6, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.45}
        Button:
            text: 'ENTRAR'
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.35}
            on_release: root.verificar_login()
        Button:
            text: 'FECHAR'
            size_hint: 0.3, 0.08
            font_size: '18sp'
            background_color: 1, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.25}
            on_release: app.fechar_aplicativo()

<SupervisorScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: "supervisor_screen"
    FloatLayout:
        Label:
            id: letreiro
            text: ''
            size_hint: None, None
            color: 0, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.6}
        Button:
            text: 'CADASTRAR VIGILANTE'
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
            on_release: root.manager.current = 'cadastro_vigilante'
        Button:
            text: 'REMOVER VIGILANTE'
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
            on_release: root.manager.current = 'remover_vigilante'
        Button:
            text: 'RELATÓRIO DE OCORRÊNCIAS'
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.3}
            on_release: root.manager.current = 'relatorio_ocorrencia'
        Button:
            text: 'SAIR'
            size_hint: 0.3, 0.08
            font_size: '18sp'
            background_color: 1, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.2}
            on_release: root.desconectar()

<CadastroVigilanteScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'cadastro_vigilante'
    FloatLayout:
        Label:
            id: letreiro_cadastro_vigilante
            text: 'CADASTRO DE VIGILANTE'
            size_hint: None, None
            color: 0, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.80}
        TextInput:
            id: nome_completo
            hint_text: 'NOME COMPLETO'
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.7}
        TextInput:
            id: matricula
            hint_text: 'MATRÍCULA'
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.6}
            input_filter: 'int'
            input_type: 'number'
            on_text: if not self.text.isdigit(): self.text = ''.join(filter(str.isdigit, self.text))
        TextInput:
            id: login_vigilante
            hint_text: 'USUÁRIO'
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
        TextInput:
            id: senha1_vigilante
            hint_text: 'DIGITE UMA SENHA'
            password: True
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
        TextInput:
            id: senha2_vigilante
            hint_text: 'REPITA A SENHA'
            password: True
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.3}
        Button:
            text: 'CADASTRAR VIGILANTE'
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.2}
            on_release: root.cadastrar_vigilante()
        Button:
            text: 'VOLTAR'
            background_color: 1, 0, 0, 1
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.1}
            on_release: root.manager.current = 'supervisor_screen'

<RelatorioOcorrenciaScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'relatorio_ocorrencia'
    FloatLayout:
        TextInput:
            id: pesquisa_posto
            hint_text: 'PESQUISA POR POSTO'
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.7}
        Button:
            text: 'PESQUISAR'
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.6}
        TextInput:
            id: pesquisa_vigilante
            hint_text: 'PESQUISA POR NOME'
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
        Button:
            text: 'PESQUISAR'
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
        RecycleView:
            id: rv
            size_hint: 0.8, 0.3
            pos_hint: {'center_x': 0.7, 'y': 0.7}
            viewclass: 'Label'
            RecycleBoxLayout:
                default_size: None, dp(30)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'
                background_color: 1, 0, 0, 1
        Button:
            text: 'VOLTAR'
            background_color: 1, 0, 0, 1
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.2}
            on_release: root.voltar()

<RemoverVigilanteScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: 'remover_vigilante'
    FloatLayout:
        Label:
            text: 'REMOVER CADASTRO'
            color: 0, 0, 0, 1
            size_hint: None, None
            pos_hint: {'center_x': 0.5, 'y': 0.6}
        TextInput:
            id: nome_vigilante_remover
            hint_text: 'NOME COMPLETO'
            multiline: False
            size_hint: 0.7, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
        Button:
            text: 'REMOVER CADASTRO'
            size_hint: (0.7, 0.08)
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.4}
            on_release: root.remover_vigilante()
        Button:
            text: 'VOLTAR'
            background_color: 1, 0, 0, 1
            size_hint: (0.3, 0.08)
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.2}
            on_release: root.manager.current = 'supervisor_screen'

<VigilanteScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: "vigilante_screen"
    FloatLayout:
        Label:
            id: letreiro_vigilante
            text: ''
            size_hint: None, None
            color: 0, 0, 0, 1
            pos_hint: {'center_x': 0.5, 'y': 0.6}
        Button:
            text: "REGISTRAR OCORRÊNCIA"
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.5}
            on_release: root.manager.current = 'ocorrencia_screen'
        Button:
            text: "Sair"
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.3}
            background_color: 1, 0, 0, 1
            on_release: root.desconectar()

<OcorrenciaScreen>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    name: "ocorrencia_screen"
    FloatLayout:
        Label:
            text: 'REGISTRAR OCORRÊNCIA'
            color: 0, 0, 0, 1
            size_hint: None, None
            pos_hint: {'center_x': 0.5, 'y': 0.85}
        TextInput:
            id: posto
            hint_text: 'NOME DO POSTO'
            multiline: False
            size_hint: 0.5, 0.06
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.8}
        TextInput:
            id: ocorrido
            hint_text: 'DIGITE A OCORRÊNCIA'
            multiline: True
            size_hint: 0.9, 0.3
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.45}
        Button:
            text: "REGISTRAR OCORRÊNCIA"
            size_hint: 0.7, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.2}
            on_release: root.registrar_ocorrencia()
        Button:
            text: "VOLTAR"
            size_hint: 0.3, 0.08
            font_size: '18sp'
            pos_hint: {'center_x': 0.5, 'y': 0.05}
            background_color: 1, 0, 0, 1
            on_release: root.manager.current = "vigilante_screen"